# Cyber Vision Center base URL including API version path (no trailing slash)
CYBERVISION_BASE_URL=https://<your-cybervision-center-host>/api/3.0

# API token from Admin > API > Token
CYBERVISION_API_TOKEN=

# Set to true when using a trusted CA (default: false for self-signed centers)
CYBERVISION_VERIFY_SSL=false

# Optional
# CYBERVISION_REQUEST_TIMEOUT=60
# CYBERVISION_MAX_RESPONSE_CHARS=100000
